# JS Neurominds V1 — environment example
# Copy to `.env` for LOCAL overrides only. NEVER commit a real .env (gitignored).
#
# IMPORTANT: Vite exposes every VITE_*-prefixed var to browser JavaScript.
# Only NON-SECRET, public-safe values belong here. Secrets (Deploy Hook URL,
# PWeNS/Gemini API keys, service accounts, OAuth tokens) must live ONLY in
# Apps Script Script Properties or Cloudflare environment settings — never here.

# API mode: "mock" (local, no backend) or "live" (connect to GAS web apps)
VITE_API_MODE=mock

# GAS web app URLs (leave blank in mock mode; set /exec URLs when live).
VITE_PUBLIC_API_URL=
VITE_ADMIN_API_URL=

# GA4 measurement ID — a public identifier that ships in the page anyway (safe).
VITE_GA4_MEASUREMENT_ID=G-WKLHEDHC5D

# ---- Admin access (production-first) ----
# Real Google OAuth client id. When set, the admin shows Google sign-in.
# When blank (default), the admin shows the clean restricted-access page.
VITE_GOOGLE_CLIENT_ID=

# DEVELOPER-ONLY simulated sign-in. Leave UNSET everywhere except a developer's
# own machine. Never commit this as "true"; builds/previews must stay restricted.
# VITE_ENABLE_MOCK_LOGIN=true

# Set to "true" only once the GA4 Data API is actually wired, so the dashboard
# shows live numbers instead of the "Real analytics not connected yet" note.
VITE_ANALYTICS_CONNECTED=

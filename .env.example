# JS Neurominds V1 — environment example
# Copy to `.env` for local overrides. NEVER commit a real .env (it is gitignored).
#
# IMPORTANT: Vite exposes every VITE_*-prefixed var to browser JavaScript.
# Only NON-SECRET, public-safe values belong here. Secrets (Deploy Hook URL,
# PWeNS/Gemini API keys, service accounts, OAuth tokens) must live ONLY in
# Apps Script Script Properties or Cloudflare environment settings — never here.

# API mode: "mock" (local, no backend) or "live" (connect to GAS web apps)
VITE_API_MODE=mock

# Environment: local | dev | production
VITE_ENV=local

# GAS web app URLs (leave blank in mock mode; set DEV /exec URLs for Phase 3).
VITE_PUBLIC_API_URL=
VITE_ADMIN_API_URL=

# GA4 measurement ID — a public identifier that ships in the page anyway (safe).
VITE_GA4_MEASUREMENT_ID=G-WKLHEDHC5D

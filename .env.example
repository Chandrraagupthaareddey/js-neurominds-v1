# JS Neurominds V1 — environment example
# Copy to `.env` for LOCAL overrides only. NEVER commit a real .env (gitignored).
#
# IMPORTANT: Vite exposes every VITE_*-prefixed var to browser JavaScript.
# Only NON-SECRET, public-safe values belong here. Secrets (Deploy Hook URL,
# PWeNS/Gemini API keys, service accounts, OAuth tokens) must live ONLY in
# Apps Script Script Properties or Cloudflare environment settings — never here.

# API mode: "mock" (local, no backend) or "live" (connect to GAS web apps)
VITE_API_MODE=mock

# Apps Script FORMS web app URL (Enquire/Callback/Lab submissions only). Content never
# comes from Apps Script any more — it is bundled from /content at build time.
VITE_PUBLIC_API_URL=
# (legacy, unused) VITE_ADMIN_API_URL=

# GA4 measurement ID — a public identifier that ships in the page anyway (safe).
VITE_GA4_MEASUREMENT_ID=G-WKLHEDHC5D

# ---- Admin ----
# The admin is the git-based CMS in /admin (see docs/ADMIN_CMS.md). It needs no env vars.
# The variables below belong to the ARCHIVED Apps Script admin-ui and are unused:
# VITE_GOOGLE_CLIENT_ID=  VITE_ALLOWED_ADMIN_EMAILS=  VITE_ENABLE_MOCK_LOGIN=  VITE_ANALYTICS_CONNECTED=

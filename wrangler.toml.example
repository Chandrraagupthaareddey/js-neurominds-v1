# Cloudflare Pages configuration — JS Neurominds V1 (EXAMPLE)
# Copy to wrangler.toml for local Wrangler use. Real wrangler.toml is gitignored.
# No secrets belong in this file. The Deploy Hook URL and any API keys live in
# Cloudflare's dashboard environment settings or Apps Script Script Properties.

name = "js-neurominds-v1"
compatibility_date = "2024-11-01"
pages_build_output_dir = "dist"

# Cloudflare Pages Git integration auto-deploys on push to main.
# Content-only rebuilds are triggered via the Deploy Hook (see docs/DEPLOYMENT.md).
